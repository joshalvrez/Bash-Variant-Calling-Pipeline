# Everything that is true only on Explorer lives here, so the job scripts
# contain no paths and the pipeline contains no Slurm.
# A list of NAME=value lines; submit.sh and both job scripts `source` it.

PARTITION=courses
ACCOUNT=binf6610.202710

# a job may start without $USER set
USER=${USER:-$(id -un)}

# the course's cohort samplesheet: eight samples, ten columns, absolute paths
SAMPLESHEET=/courses/BINF6610.202710/data/samplesheet-variant8.csv

# my image, as the .sif that slurm/pull.sbatch fetched. Since week 3 the tools
# come from here and not from the course conda environment.
SIF=/scratch/${USER}/containers/variant-call.sif

# the folder this repository was cloned into
PIPELINE_DIR=${HOME}/Bash-Variant-Calling-Pipeline

# where the run writes its files. A new folder for week 3: in last week's
# (w2-run) every stage would find its output and skip, so nothing would run in
# the image. Can be overridden for a test run:
#   sbatch --export=RUN_ROOT=/scratch/$USER/some-folder ...
RUN_ROOT=${RUN_ROOT:-/scratch/${USER}/w3-run}
