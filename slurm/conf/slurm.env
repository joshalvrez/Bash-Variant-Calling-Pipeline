# Everything that is true only on Explorer lives here, so the job scripts
# contain no paths and the pipeline contains no Slurm.
# A list of NAME=value lines; submit.sh and both job scripts `source` it.

PARTITION=courses
ACCOUNT=binf6610.202710

# a job may start without $USER set
USER=${USER:-$(id -un)}

# the course's cohort samplesheet: eight samples, ten columns, absolute paths
SAMPLESHEET=/courses/BINF6610.202710/data/samplesheet-variant8.csv

# the course environment that provides every tool the stages call
CONDA_ENV=/courses/BINF6610.202710/shared/env/binf6610

# the folder this repository was cloned into  <-- EDIT: your repository's name
PIPELINE_DIR=${HOME}/Bash-Variant-Calling-Pipeline

# where the run writes its files. Can be overridden for a probe run:
#   sbatch --export=RUN_ROOT=/scratch/$USER/probe-c4 ...
RUN_ROOT=${RUN_ROOT:-/scratch/${USER}/w2-run}
